<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Interactive 3D visualization of the Bi-Cephalic Self-Attention Model (BiSAM) for classifying Parkinson's disease patients with freezing of gait." />
  <title>BiSAM 3D FOG Classification Visualizer</title>
  <style>
    :root {
      --red: #df1111;
      --red-dark: #a90d0d;
      --ink: #171717;
      --muted: #686868;
      --surface: rgba(255, 255, 255, 0.9);
      --line: rgba(23, 23, 23, 0.14);
      --shadow: 0 18px 60px rgba(35, 0, 0, 0.15);
    }

    * { box-sizing: border-box; }

    html, body {
      width: 100%;
      min-height: 100%;
      margin: 0;
      background:
        radial-gradient(circle at 12% 10%, rgba(223, 17, 17, 0.14), transparent 28%),
        radial-gradient(circle at 88% 16%, rgba(223, 17, 17, 0.08), transparent 24%),
        #f7f6f4;
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    body {
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    .shell {
      width: min(1500px, 100%);
      margin: 0 auto;
      padding: 22px;
      display: grid;
      gap: 18px;
      flex: 1;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      padding: 16px 18px;
      border: 1px solid var(--line);
      border-radius: 20px;
      background: var(--surface);
      backdrop-filter: blur(16px);
      box-shadow: var(--shadow);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 13px;
    }

    .logo {
      width: 46px;
      height: 46px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      color: #fff;
      background: linear-gradient(135deg, var(--red), #ff5656);
      font-weight: 900;
      letter-spacing: -0.04em;
      box-shadow: 0 10px 28px rgba(223, 17, 17, 0.3);
    }

    .brand-title {
      margin: 0;
      font-size: clamp(1.05rem, 1.9vw, 1.45rem);
      line-height: 1.15;
    }

    .brand-copy {
      margin: 4px 0 0;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .controls {
      display: flex;
      gap: 9px;
      flex-wrap: wrap;
    }

    button, select {
      min-height: 42px;
      border-radius: 12px;
      border: 1px solid var(--line);
      padding: 0 14px;
      font: inherit;
    }

    button {
      cursor: pointer;
      font-weight: 750;
      background: #fff;
      color: var(--ink);
      transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
    }

    button:hover { transform: translateY(-1px); border-color: rgba(223, 17, 17, 0.45); }
    button:focus-visible, select:focus-visible { outline: 3px solid rgba(223, 17, 17, 0.28); outline-offset: 2px; }

    .primary {
      color: #fff;
      border-color: transparent;
      background: linear-gradient(135deg, var(--red), #f14c4c);
      box-shadow: 0 9px 22px rgba(223, 17, 17, 0.22);
    }

    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 330px;
      gap: 18px;
      min-height: 720px;
    }

    .stage-wrap {
      position: relative;
      min-height: 720px;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 24px;
      background:
        linear-gradient(rgba(255,255,255,0.06), rgba(255,255,255,0.06)),
        radial-gradient(circle at 50% 30%, #333 0, #171717 45%, #080808 100%);
      box-shadow: var(--shadow);
    }

    #scene {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      touch-action: none;
    }

    .scene-label {
      position: absolute;
      left: 18px;
      top: 18px;
      padding: 10px 13px;
      border: 1px solid rgba(255,255,255,0.16);
      border-radius: 13px;
      color: #fff;
      background: rgba(0,0,0,0.42);
      backdrop-filter: blur(10px);
      font-size: 0.86rem;
      pointer-events: none;
    }

    .legend {
      position: absolute;
      left: 18px;
      bottom: 18px;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      max-width: calc(100% - 36px);
      pointer-events: none;
    }

    .pill {
      padding: 8px 10px;
      border-radius: 999px;
      color: #fff;
      background: rgba(0,0,0,0.52);
      border: 1px solid rgba(255,255,255,0.15);
      font-size: 0.76rem;
      backdrop-filter: blur(10px);
    }

    .sidebar {
      display: grid;
      align-content: start;
      gap: 14px;
    }

    .card {
      padding: 17px;
      border: 1px solid var(--line);
      border-radius: 20px;
      background: var(--surface);
      backdrop-filter: blur(14px);
      box-shadow: 0 12px 38px rgba(30, 0, 0, 0.08);
    }

    .eyebrow {
      margin: 0 0 5px;
      color: var(--red);
      font-size: 0.76rem;
      font-weight: 850;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .card-title {
      margin: 0;
      font-size: 1.05rem;
    }

    .classification {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 14px;
      padding: 15px;
      border-radius: 16px;
      background: #fff;
      border: 1px solid var(--line);
    }

    .class-name {
      font-size: 1.1rem;
      font-weight: 900;
    }

    .confidence {
      font-size: 1.35rem;
      font-weight: 900;
      color: var(--red);
    }

    .meter {
      height: 10px;
      margin-top: 12px;
      overflow: hidden;
      border-radius: 999px;
      background: #e7e3e1;
    }

    .meter > span {
      display: block;
      width: 88%;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--red-dark), #ff5c5c);
      transition: width 480ms ease;
    }

    .steps {
      display: grid;
      gap: 9px;
      margin-top: 13px;
    }

    .step {
      display: grid;
      grid-template-columns: 30px 1fr;
      gap: 9px;
      align-items: center;
      padding: 9px;
      border-radius: 12px;
      border: 1px solid transparent;
      transition: background 180ms ease, border-color 180ms ease;
    }

    .step.active {
      background: rgba(223, 17, 17, 0.08);
      border-color: rgba(223, 17, 17, 0.2);
    }

    .step-number {
      width: 30px;
      height: 30px;
      display: grid;
      place-items: center;
      border-radius: 9px;
      color: #fff;
      background: var(--ink);
      font-size: 0.82rem;
      font-weight: 850;
    }

    .step.active .step-number { background: var(--red); }

    .step strong { display: block; font-size: 0.88rem; }
    .step small { color: var(--muted); }

    .channel-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 7px;
      margin-top: 12px;
    }

    .channel {
      padding: 7px 4px;
      text-align: center;
      border-radius: 9px;
      background: #fff;
      border: 1px solid var(--line);
      font-size: 0.72rem;
      font-weight: 800;
    }

    .note {
      color: var(--muted);
      font-size: 0.82rem;
      line-height: 1.55;
    }

    footer {
      padding: 18px 22px 25px;
      text-align: center;
      color: #606060;
      font-size: 0.88rem;
    }

    @media (max-width: 980px) {
      .layout { grid-template-columns: 1fr; }
      .stage-wrap { min-height: 620px; }
      .sidebar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 640px) {
      .shell { padding: 12px; }
      .topbar { padding: 14px; }
      .controls { width: 100%; }
      .controls > * { flex: 1 1 120px; }
      .stage-wrap { min-height: 560px; }
      .sidebar { grid-template-columns: 1fr; }
      .brand-copy { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; }
    }
  </style>
</head>
<body>
  <main class="shell">
    <section class="topbar" aria-label="BiSAM visualization controls">
      <div class="brand">
        <div class="logo" aria-hidden="true">Bi</div>
        <div>
          <p class="brand-title"><strong>BiSAM 3D FOG Classification Visualizer</strong></p>
          <p class="brand-copy">EEG + descriptive variables → bi-cephalic attention → PDFOG classification</p>
        </div>
      </div>

      <div class="controls">
        <label>
          <span class="sr-only" style="position:absolute;clip:rect(0 0 0 0);clip-path:inset(50%);height:1px;width:1px;overflow:hidden;white-space:nowrap;">EEG channel configuration</span>
          <select id="channelMode" aria-label="EEG channel configuration">
            <option value="4">BiSAM-4</option>
            <option value="8" selected>BiSAM-8</option>
            <option value="16">BiSAM-16</option>
            <option value="63">BiSAM-63</option>
          </select>
        </label>
        <button id="toggleRotation" type="button">Pause rotation</button>
        <button id="resetView" type="button">Reset view</button>
        <button id="runModel" class="primary" type="button">Run BiSAM</button>
      </div>
    </section>

    <section class="layout">
      <div class="stage-wrap" aria-label="Interactive 3D BiSAM model visualization">
        <canvas id="scene"></canvas>
        <div class="scene-label" id="sceneStatus" role="status" aria-live="polite">Model ready — drag to rotate, scroll to zoom</div>
        <div class="legend" aria-hidden="true">
          <span class="pill">Red: EEG signal path</span>
          <span class="pill">White: descriptive features</span>
          <span class="pill">Attention heads: signal + context</span>
        </div>
      </div>

      <aside class="sidebar" aria-label="BiSAM model details">
        <section class="card">
          <p class="eyebrow">Prediction</p>
          <p class="card-title"><strong>FOG-Specific Classification</strong></p>
          <div class="classification">
            <div>
              <div class="class-name" id="className">PDFOG+</div>
              <small id="classDescription">Parkinson's disease with freezing of gait</small>
            </div>
            <div class="confidence" id="confidence">88%</div>
          </div>
          <div class="meter" aria-label="Classification confidence">
            <span id="confidenceBar"></span>
          </div>
        </section>

        <section class="card">
          <p class="eyebrow">Inference pipeline</p>
          <p class="card-title"><strong>How BiSAM Processes the Data</strong></p>
          <div class="steps" id="steps">
            <div class="step active"><span class="step-number">1</span><span><strong>EEG Input</strong><small>Resting-state channel features</small></span></div>
            <div class="step"><span class="step-number">2</span><span><strong>Signal Head</strong><small>Self-attention over EEG features</small></span></div>
            <div class="step"><span class="step-number">3</span><span><strong>Context Head</strong><small>Age, education, disease duration</small></span></div>
            <div class="step"><span class="step-number">4</span><span><strong>Feature Fusion</strong><small>Multimodal representation</small></span></div>
            <div class="step"><span class="step-number">5</span><span><strong>Classification</strong><small>PDFOG+, PDFOG−, or HC</small></span></div>
          </div>
        </section>

        <section class="card">
          <p class="eyebrow">Active configuration</p>
          <p class="card-title"><strong id="configurationName">BiSAM-8</strong></p>
          <div class="channel-grid" id="channelGrid"></div>
          <p class="note" id="configurationNote">Eight representative EEG channels are shown for a compact, high-performing multimodal configuration.</p>
        </section>

        <section class="card">
          <p class="eyebrow">Portfolio note</p>
          <p class="note">This is an educational visualization of the architecture and inference flow. It is not a clinical diagnostic tool and does not process real patient data.</p>
        </section>
      </aside>
    </section>
  </main>

  <footer>Designed &amp; Developed © Shomoita Jahid Mitin</footer>

  <script type="importmap">
    {
      "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js",
        "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/"
      }
    }
  </script>

  <script type="module">
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

    const canvas = document.querySelector('#scene');
    const stage = canvas.parentElement;
    const sceneStatus = document.querySelector('#sceneStatus');
    const channelMode = document.querySelector('#channelMode');
    const toggleRotation = document.querySelector('#toggleRotation');
    const resetView = document.querySelector('#resetView');
    const runModel = document.querySelector('#runModel');
    const stepElements = [...document.querySelectorAll('.step')];
    const confidence = document.querySelector('#confidence');
    const confidenceBar = document.querySelector('#confidenceBar');
    const className = document.querySelector('#className');
    const classDescription = document.querySelector('#classDescription');
    const configurationName = document.querySelector('#configurationName');
    const configurationNote = document.querySelector('#configurationNote');
    const channelGrid = document.querySelector('#channelGrid');

    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x080808, 0.035);

    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
    camera.position.set(0, 5.5, 16.5);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.055;
    controls.minDistance = 9;
    controls.maxDistance = 24;
    controls.maxPolarAngle = Math.PI * 0.72;
    controls.target.set(0, 0.4, 0);
    controls.autoRotate = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    controls.autoRotateSpeed = 0.7;

    scene.add(new THREE.HemisphereLight(0xffffff, 0x360000, 2.1));
    const keyLight = new THREE.DirectionalLight(0xffffff, 3.5);
    keyLight.position.set(7, 10, 8);
    scene.add(keyLight);
    const redLight = new THREE.PointLight(0xdf1111, 55, 22, 2);
    redLight.position.set(-6, 2, 4);
    scene.add(redLight);

    const world = new THREE.Group();
    scene.add(world);

    const grid = new THREE.GridHelper(28, 28, 0x5f1a1a, 0x292929);
    grid.position.y = -3.2;
    world.add(grid);

    const materials = {
      eeg: new THREE.MeshStandardMaterial({ color: 0xdf1111, emissive: 0x520000, emissiveIntensity: 0.5, metalness: 0.28, roughness: 0.3 }),
      context: new THREE.MeshStandardMaterial({ color: 0xf4f4f4, emissive: 0x242424, emissiveIntensity: 0.25, metalness: 0.16, roughness: 0.26 }),
      attention: new THREE.MeshStandardMaterial({ color: 0xff5d5d, emissive: 0x6b0707, emissiveIntensity: 0.65, metalness: 0.4, roughness: 0.22 }),
      fusion: new THREE.MeshStandardMaterial({ color: 0x9f1010, emissive: 0x4d0000, emissiveIntensity: 0.75, metalness: 0.55, roughness: 0.2 }),
      output: new THREE.MeshStandardMaterial({ color: 0xffffff, emissive: 0x510000, emissiveIntensity: 0.45, metalness: 0.35, roughness: 0.18 })
    };

    function makeTextSprite(text, color = '#ffffff', scale = [2.4, 0.62, 1]) {
      const c = document.createElement('canvas');
      c.width = 512;
      c.height = 128;
      const ctx = c.getContext('2d');
      ctx.clearRect(0, 0, c.width, c.height);
      ctx.fillStyle = 'rgba(0,0,0,0.62)';
      ctx.roundRect(8, 16, 496, 96, 22);
      ctx.fill();
      ctx.strokeStyle = 'rgba(255,255,255,0.16)';
      ctx.lineWidth = 3;
      ctx.stroke();
      ctx.font = '700 42px Inter, Arial, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillStyle = color;
      ctx.fillText(text, 256, 66);
      const texture = new THREE.CanvasTexture(c);
      texture.colorSpace = THREE.SRGBColorSpace;
      const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: texture, transparent: true, depthWrite: false }));
      sprite.scale.set(...scale);
      return sprite;
    }

    function createNode(position, radius, material, label, labelOffset = 0.75) {
      const mesh = new THREE.Mesh(new THREE.IcosahedronGeometry(radius, 3), material.clone());
      mesh.position.copy(position);
      mesh.userData.baseScale = 1;
      mesh.userData.phase = Math.random() * Math.PI * 2;
      world.add(mesh);
      if (label) {
        const sprite = makeTextSprite(label, '#ffffff', [2.0, 0.5, 1]);
        sprite.position.copy(position).add(new THREE.Vector3(0, labelOffset, 0));
        world.add(sprite);
      }
      return mesh;
    }

    function createLine(a, b, color, opacity = 0.5) {
      const geometry = new THREE.BufferGeometry().setFromPoints([a, b]);
      const material = new THREE.LineBasicMaterial({ color, transparent: true, opacity });
      const line = new THREE.Line(geometry, material);
      world.add(line);
      return line;
    }

    const signalGroup = new THREE.Group();
    world.add(signalGroup);
    const contextGroup = new THREE.Group();
    world.add(contextGroup);

    const signalHead = createNode(new THREE.Vector3(-1.6, 1.4, 0), 0.78, materials.attention, 'Signal attention', 1.05);
    const contextHead = createNode(new THREE.Vector3(-1.6, -1.25, 0), 0.78, materials.context, 'Context attention', -1.05);
    const fusionNode = createNode(new THREE.Vector3(2.1, 0.15, 0), 1.02, materials.fusion, 'Multimodal fusion', 1.3);
    const outputNode = createNode(new THREE.Vector3(5.6, 0.15, 0), 1.18, materials.output, 'PDFOG+', 1.45);

    createLine(signalHead.position, fusionNode.position, 0xff3535, 0.9);
    createLine(contextHead.position, fusionNode.position, 0xffffff, 0.72);
    createLine(fusionNode.position, outputNode.position, 0xff5a5a, 0.92);

    const contextLabels = ['Age', 'Education', 'Disease duration'];
    const contextNodes = contextLabels.map((label, index) => {
      const y = 1.8 - index * 1.7;
      const node = createNode(new THREE.Vector3(-5.2, y, 2.25), 0.42, materials.context, label, 0.72);
      contextGroup.add(node);
      createLine(node.position, contextHead.position, 0xffffff, 0.34);
      return node;
    });

    const eegNodes = [];
    const eegLines = [];
    const particles = [];

    function clearEEG() {
      eegNodes.splice(0).forEach(node => {
        world.remove(node);
        node.geometry.dispose();
        node.material.dispose();
      });
      eegLines.splice(0).forEach(line => {
        world.remove(line);
        line.geometry.dispose();
        line.material.dispose();
      });
      particles.splice(0).forEach(p => {
        world.remove(p.mesh);
        p.mesh.geometry.dispose();
        p.mesh.material.dispose();
      });
    }

    const channelNames = ['Fp1','Fp2','F3','F4','C3','C4','P3','P4','F7','F8','T3','T4','T5','T6','O1','O2'];

    function buildEEG(count) {
      clearEEG();
      const displayCount = Math.min(count, 24);
      const columns = count <= 4 ? 2 : count <= 8 ? 3 : count <= 16 ? 4 : 6;
      for (let i = 0; i < displayCount; i++) {
        const row = Math.floor(i / columns);
        const col = i % columns;
        const x = -7.2 + col * (2.7 / Math.max(columns - 1, 1));
        const y = 2.65 - row * (5.3 / Math.max(Math.ceil(displayCount / columns) - 1, 1));
        const z = Math.sin(i * 1.55) * 0.72;
        const node = new THREE.Mesh(new THREE.SphereGeometry(count >= 63 ? 0.18 : 0.25, 18, 18), materials.eeg.clone());
        node.position.set(x, y, z);
        node.userData.phase = i * 0.37;
        world.add(node);
        eegNodes.push(node);

        const line = createLine(node.position, signalHead.position, 0xdf1111, count >= 63 ? 0.18 : 0.34);
        eegLines.push(line);

        if (i < 12) {
          const particle = new THREE.Mesh(
            new THREE.SphereGeometry(0.065, 10, 10),
            new THREE.MeshBasicMaterial({ color: 0xff6a6a })
          );
          particle.position.copy(node.position);
          world.add(particle);
          particles.push({ mesh: particle, from: node.position.clone(), to: signalHead.position.clone(), offset: i / 12 });
        }
      }
      updateChannelUI(count);
    }

    function updateChannelUI(count) {
      configurationName.textContent = `BiSAM-${count}`;
      const visibleNames = count === 63 ? ['63-channel', 'whole-scalp', 'EEG array'] : channelNames.slice(0, count);
      channelGrid.innerHTML = visibleNames.map(name => `<span class="channel">${name}</span>`).join('');
      configurationNote.textContent = count === 63
        ? 'The scene renders a representative subset while the label indicates the full 63-channel configuration.'
        : `${count} representative EEG channels feed the signal-attention head alongside descriptive variables.`;
    }

    const haloGeometry = new THREE.TorusGeometry(1.5, 0.035, 12, 120);
    const signalHalo = new THREE.Mesh(haloGeometry, new THREE.MeshBasicMaterial({ color: 0xdf1111, transparent: true, opacity: 0.7 }));
    signalHalo.position.copy(signalHead.position);
    signalHalo.rotation.x = Math.PI / 2;
    world.add(signalHalo);

    const contextHalo = signalHalo.clone();
    contextHalo.material = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.34 });
    contextHalo.position.copy(contextHead.position);
    world.add(contextHalo);

    const fusionRings = [1.45, 1.8, 2.15].map((radius, i) => {
      const ring = new THREE.Mesh(
        new THREE.TorusGeometry(radius, 0.025, 10, 100),
        new THREE.MeshBasicMaterial({ color: i % 2 ? 0xffffff : 0xdf1111, transparent: true, opacity: 0.34 })
      );
      ring.position.copy(fusionNode.position);
      ring.rotation.set(Math.PI / 2, i * 0.8, i * 0.55);
      world.add(ring);
      return ring;
    });

    buildEEG(8);

    let running = false;
    let activeStep = 0;
    let stepTimer = null;

    const predictionSets = {
      4: { label: 'PDFOG+', description: "Parkinson's disease with freezing of gait", score: 88 },
      8: { label: 'PDFOG+', description: "Parkinson's disease with freezing of gait", score: 88 },
      16: { label: 'PDFOG−', description: "Parkinson's disease without freezing of gait", score: 82 },
      63: { label: 'HC', description: 'Age-matched healthy control', score: 79 }
    };

    function setStep(index) {
      activeStep = index;
      stepElements.forEach((step, i) => step.classList.toggle('active', i === index));
      const labels = ['Reading EEG features', 'Applying signal self-attention', 'Applying descriptive-variable attention', 'Fusing multimodal features', 'Generating FOG-specific class'];
      sceneStatus.textContent = labels[index];
    }

    function runInference() {
      if (running) return;
      running = true;
      runModel.disabled = true;
      runModel.textContent = 'Running…';
      setStep(0);
      let index = 0;
      stepTimer = window.setInterval(() => {
        index += 1;
        if (index < 5) {
          setStep(index);
          return;
        }
        clearInterval(stepTimer);
        const selected = predictionSets[channelMode.value];
        className.textContent = selected.label;
        classDescription.textContent = selected.description;
        confidence.textContent = `${selected.score}%`;
        confidenceBar.style.width = `${selected.score}%`;
        outputNode.scale.setScalar(1.3);
        outputNode.material.emissiveIntensity = 1.5;
        sceneStatus.textContent = `Classification complete: ${selected.label} (${selected.score}% demo confidence)`;
        setTimeout(() => {
          outputNode.scale.setScalar(1);
          outputNode.material.emissiveIntensity = 0.45;
          running = false;
          runModel.disabled = false;
          runModel.textContent = 'Run BiSAM';
        }, 700);
      }, 720);
    }

    runModel.addEventListener('click', runInference);

    channelMode.addEventListener('change', () => {
      buildEEG(Number(channelMode.value));
      const selected = predictionSets[channelMode.value];
      className.textContent = selected.label;
      classDescription.textContent = selected.description;
      confidence.textContent = `${selected.score}%`;
      confidenceBar.style.width = `${selected.score}%`;
      sceneStatus.textContent = `${configurationName.textContent} loaded — ready to run`;
    });

    toggleRotation.addEventListener('click', () => {
      controls.autoRotate = !controls.autoRotate;
      toggleRotation.textContent = controls.autoRotate ? 'Pause rotation' : 'Resume rotation';
    });

    resetView.addEventListener('click', () => {
      camera.position.set(0, 5.5, 16.5);
      controls.target.set(0, 0.4, 0);
      controls.update();
      sceneStatus.textContent = 'View reset';
    });

    function resize() {
      const width = stage.clientWidth;
      const height = stage.clientHeight;
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    }

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(stage);

    const clock = new THREE.Clock();
    function animate() {
      const t = clock.getElapsedTime();
      controls.update();

      eegNodes.forEach((node, i) => {
        const pulse = 1 + Math.sin(t * 2.1 + node.userData.phase) * 0.08;
        node.scale.setScalar(pulse);
        node.material.emissiveIntensity = 0.42 + Math.sin(t * 2.4 + i) * 0.18;
      });

      particles.forEach((p, i) => {
        const progress = (t * 0.22 + p.offset) % 1;
        p.mesh.position.lerpVectors(p.from, p.to, progress);
        p.mesh.scale.setScalar(0.65 + Math.sin(progress * Math.PI) * 0.8);
      });

      signalHalo.rotation.z = t * 0.45;
      contextHalo.rotation.z = -t * 0.35;
      fusionRings.forEach((ring, i) => {
        ring.rotation.z += 0.0025 * (i + 1);
        ring.rotation.y += 0.0018 * (i + 1);
      });

      signalHead.scale.setScalar(1 + Math.sin(t * 2.2) * 0.025);
      contextHead.scale.setScalar(1 + Math.cos(t * 2.0) * 0.025);
      fusionNode.rotation.y = t * 0.24;
      outputNode.rotation.y = -t * 0.18;

      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }

    resize();
    animate();
  </script>
</body>
</html>
